<form version="1.1" theme="dark">
  <label>Team 5 — SIEM Overview (P8)</label>
  <description>Defense in Depth — Splunk ingestion from Palo Alto PA-440, FortiGate 61F, IIS Web Servers (UF), and Security Onion. All panels render on RAW data with no add-ons required.</description>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="tr">
      <label>Time Range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>

  <!-- ROW 1: single-value "everything is alive" proof -->
  <row>
    <panel>
      <title>Firewall Events</title>
      <single>
        <search>
          <query>index=firewall | stats count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0x53a051"]</option>
        <option name="useColors">1</option>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Windows / IIS Events (Web Servers)</title>
      <single>
        <search>
          <query>index=wineventlog | stats count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0x53a051"]</option>
        <option name="useColors">1</option>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Security Onion Events</title>
      <single>
        <search>
          <query>index=securityonion | stats count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0xf8be34","0x53a051"]</option>
        <option name="rangeValues">[1]</option>
        <option name="useColors">1</option>
        <option name="drilldown">none</option>
      </single>
    </panel>
  </row>

  <!-- ROW 2: all sources over time -->
  <row>
    <panel>
      <title>All Sources — Events Over Time</title>
      <chart>
        <search>
          <query>index=firewall OR index=wineventlog OR index=securityonion | timechart count by index</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.axisTitleY.text">Event Count</option>
        <option name="charting.chart.nullValueMode">zero</option>
      </chart>
    </panel>
  </row>

  <!-- ROW 3: prove both firewalls, both web servers -->
  <row>
    <panel>
      <title>Firewall Events by Sourcetype (Palo Alto vs FortiGate)</title>
      <chart>
        <search>
          <query>index=firewall | timechart count by sourcetype</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
    <panel>
      <title>Windows Events by Host (Web1 vs Web2)</title>
      <chart>
        <search>
          <query>index=wineventlog | stats count by host | sort - count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.legend.placement">none</option>
      </chart>
    </panel>
  </row>

  <!-- ROW 4: security-flavored panels on raw text + EventCode -->
  <row>
    <panel>
      <title>Firewall — Authentication Failures / Denies Over Time</title>
      <chart>
        <search>
          <query>index=firewall ("auth-fail" OR "Authentication failed" OR "Invalid User" OR "deny" OR "drop") | timechart count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">area</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.axisTitleY.text">Suspicious Events</option>
      </chart>
    </panel>
    <panel>
      <title>Windows — Top Event Codes</title>
      <table>
        <search>
          <query>index=wineventlog | top limit=10 EventCode</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">10</option>
      </table>
    </panel>
  </row>

</form>
